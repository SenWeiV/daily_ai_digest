# ===========================================
# Daily AI Digest - 环境变量配置模板
# ===========================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# -------------------------------------------
# 文本模型角色（默认 DeepSeek V4 Flash）
# -------------------------------------------
# 获取方式：
# - DeepSeek: https://platform.deepseek.com/   ← 默认
# - Kimi (月之暗面): https://platform.moonshot.cn/
# - 通义千问: https://dashscope.console.aliyun.com/
# - 智谱 AI: https://open.bigmodel.cn/
#
# 变量名从 GEMINI_* 改成 TEXT_*：这里跑的从来不是 Gemini，叫错名字会让运维在
# 三个模型角色之间选错端点。旧的 GEMINI_* 仍被识别（新名优先），所以老部署不会
# 因为漏改一处而静默退化成"密钥为空"——那表现为收集成功、每条分析失败，
# 邮件看起来只是内容变薄，在收件箱里几乎发现不了。

# API 密钥（必须与下面的 TEXT_BASE_URL 属于同一家；Kimi 的 key 在 DeepSeek 上会认证失败）
TEXT_API_KEY=your_deepseek_api_key_here

# API 地址（OpenAI 兼容接口）
# DeepSeek: https://api.deepseek.com          ← 默认，/v1 与不带 /v1 两种写法都可
# Kimi: https://api.moonshot.cn/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 AI: https://open.bigmodel.cn/api/paas/v4
# 私有部署: http://your-server:port
TEXT_BASE_URL=https://api.deepseek.com

# 模型名称
# DeepSeek: deepseek-v4-flash（默认）, deepseek-v4-pro
# Kimi: kimi-k2.5 —— 注意 kimi-k2.5 与全部 moonshot-v1-* 于 2026-08-31 下线
# 通义千问: qwen-turbo, qwen-plus, qwen-max
# 智谱 AI: glm-4, glm-4-flash
TEXT_MODEL=deepseek-v4-flash

# 没有 TEXT_TEMPERATURE / TEXT_MAX_TOKENS，这是刻意的：
# 请求只发 model + messages，其余一律用 provider 默认值（思考模式因此保持开启，
# 上下文与输出长度按各家上限）。写死 max_tokens 会在长 README 上截断答案，
# 截断的 JSON 解析失败后落成"分析为空"；写死 temperature 在部分模型上直接 400。

# 回退模型（逗号分隔，可选）。留空表示只用一个模型，失败即视为该条目分析失败。
TEXT_FALLBACK_MODELS=

# -------------------------------------------
# 视觉质检角色（多模态，独立配置）
# -------------------------------------------
# 上面的 TEXT_* 是纯文本角色，这里是看图角色，两者不互为 fallback：
# 文本模型收到图片会编造一个像样的"通过"结论，假通过比没有结论更糟。
#
# ⚠️ api.moonshot.cn 与 api.moonshot.ai 是两个独立平台：账号、密钥、计价货币
# 都不通用，双方文档互不提及。把 .cn 的 key 填给 .ai（或反过来）只会得到
# authentication_error。国内服务器一律用 .cn —— 北京 IP 实测 .cn 10/10 通
# （~0.1s），.ai 6/10（4 次超时）。
VISION_API_KEY=your_moonshot_cn_api_key_here
VISION_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=kimi-k3

# -------------------------------------------
# 生图角色（火山方舟 Seedream，独立配置）
# -------------------------------------------
# 必须用 Lite 而非 Pro：5.0 Pro 不支持组图（sequential_image_generation），
# 四张小红书图会像四个不相干的帖子。
# 固定带日期的标识符，不用滚动别名：上游换模型会静默改变风格与成本。
IMAGE_GEN_API_KEY=your_volcengine_ark_api_key_here
IMAGE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GEN_MODEL=doubao-seedream-5-0-260128
IMAGE_GEN_TIMEOUT_SECONDS=120
# 按出图张数计费（¥0.22/张），所以上限是张数而不是 token
IMAGE_GEN_MAX_PER_RUN=5
# 水印默认关闭。provider 默认是 true，会在右下角盖"AI生成"；
# 请求里不显式带这个字段就等于交付带水印的图。
IMAGE_GEN_WATERMARK=false

# -------------------------------------------
# 长图渲染与视觉质检
# -------------------------------------------
# 三个开关默认全关：浏览器、生图、视觉是三个独立故障域，
# 邮件每天到达比图片更重要。容器内验证通过后再逐个打开。
RENDER_ENABLED=false
IMAGE_GEN_ENABLED=false
VISUAL_QA_ENABLED=false

RENDER_OUTPUT_DIR=../data/renders
RENDER_DEVICE_SCALE_FACTOR=2
# Chromium 单张纹理上限 16384px，超过会静默截断。留出余量。
RENDER_SEGMENT_MAX_HEIGHT=15000
RENDER_TIMEOUT_SECONDS=120
RENDER_RETENTION_DAYS=14

QA_MAX_ATTEMPTS=3
# 送检请求体上限（字节）。K3 上限 100MB，留足余量。
QA_MAX_REQUEST_BYTES=62914560
# 送检副本的最小边长。低于这个值文字缺陷不再可辨，
# 而"看不清所以没发现问题"会被报成通过——本设计里最坏的结果。
# 到达下限仍超体积时必须分段送检，不能继续缩小。
QA_MIN_INSPECT_DIMENSION=900
QA_TIMEOUT_SECONDS=300

# 附件总预算（字节）。超预算时保留长图，按固定顺序丢平台图，
# 顺序见 backend/app/services/attachment_budget.py 的 PLATFORM_DROP_ORDER。
ATTACHMENT_BUDGET_BYTES=20971520

# -------------------------------------------
# 平台文案产出
# -------------------------------------------
# 关闭的平台不产出文案，且不算作失败。
PUBLISH_PLATFORMS=xiaohongshu,wechat,x,instagram,zhihu,reddit
PUBLISHERS_ENABLED=false

# -------------------------------------------
# GitHub API 配置
# -------------------------------------------
# 获取方式：
# 1. 登录 GitHub
# 2. Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# 3. Generate new token，勾选 public_repo 权限
GITHUB_TOKEN=your_github_token_here
GITHUB_CANDIDATE_LIMIT=24
GITHUB_ACTIVE_PROJECT_DAYS=14
# 可选，使用分号分隔窄查询；留空使用内置研究主题查询
GITHUB_SEARCH_QUERIES=
GITHUB_TRENDING_ATTEMPT_TIMEOUT_SECONDS=120
GITHUB_TRENDING_MAX_ATTEMPTS=10
GITHUB_SOCIAL_WINDOW_DAYS=14
GITHUB_RECENT_COMMENT_LIMIT=100
GITHUB_MIN_RECENT_COMMENTS_A=5
GITHUB_ACTIVITY_SIGNAL_THRESHOLD=10

# arXiv 与动态研究内容选择
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.LG,cs.IR,cs.RO
ARXIV_CANDIDATE_LIMIT=24
ARXIV_TIMEOUT_SECONDS=20
TARGET_ITEMS=10
MAX_ITEMS=24

# -------------------------------------------
# 邮件服务配置（支持 Gmail / 163 / QQ 等）
# -------------------------------------------
# SMTP 服务器地址
# - 163 邮箱: smtp.163.com
# - QQ 邮箱: smtp.qq.com
# - Gmail: smtp.gmail.com
SMTP_SERVER=smtp.163.com

# SMTP 端口
# - 163/QQ 邮箱: 465 (SSL)
# - Gmail: 587 (STARTTLS)
SMTP_PORT=465

# 是否使用 SSL 直连
# - 163/QQ 邮箱: true
# - Gmail: false
SMTP_USE_SSL=true

# 发件人邮箱地址
EMAIL_SENDER=your_email@163.com

# 授权码（非登录密码！）
# 163 邮箱获取方式：
# 1. 登录 163 邮箱网页版
# 2. 设置 -> POP3/SMTP/IMAP
# 3. 开启 IMAP/SMTP 服务
# 4. 获取授权码（需要短信验证）
EMAIL_PASSWORD=your_authorization_code

# 收件人邮箱（接收摘要的邮箱，可与发件人相同；多个收件人用英文逗号分隔）
EMAIL_RECIPIENT=your_email@163.com

# -------------------------------------------
# 旧版 Gmail 配置（仍兼容，推荐使用上面的通用配置）
# -------------------------------------------
# GMAIL_SENDER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
# DIGEST_RECIPIENT=your_email@gmail.com

# -------------------------------------------
# 定时任务配置
# -------------------------------------------
# 日报送达时间（24小时制）。提前 DIGEST_PREPARE_LEAD_MINUTES 分钟开始整理
# 前一天的内容，整理完等到这个时刻再发
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
DIGEST_PREPARE_LEAD_MINUTES=30
# 时区
TIMEZONE=Asia/Shanghai

# -------------------------------------------
# 应用配置
# -------------------------------------------
# 调试模式
DEBUG=false
# 数据库路径
DATABASE_PATH=../data/digest.db
# 日志级别
LOG_LEVEL=INFO

# -------------------------------------------
# CORS 配置（可选）
# -------------------------------------------
# 允许的前端域名，逗号分隔
# CORS_ALLOW_ORIGINS=https://your-frontend.com,http://localhost:3000