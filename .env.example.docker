# Daily AI Digest - Docker 部署环境变量模板
# 复制此文件为 .env 并填入你的实际配置
# cp .env.example.docker .env

# ============================================
# 文本模型角色（必填）
# ============================================
# 支持 DeepSeek/Kimi/通义千问等 OpenAI 兼容接口
# key 必须与 BASE_URL 属于同一家，跨家使用会认证失败
#
# 变量名从 GEMINI_* 改成 TEXT_*。旧名仍被识别（新名优先），
# 所以老部署漏改一处不会静默退化成"密钥为空"。

# DeepSeek 示例（默认）
TEXT_API_KEY=<your-deepseek-api-key>
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash

# Kimi (月之暗面) 示例
# 注意：api.moonshot.cn 与 api.moonshot.ai 是两个独立平台，账号、密钥、计价货币都不通用，
# 双方文档互不提及。国内服务器只走 .cn。且 kimi-k2.5 与全部 moonshot-v1-* 于 2026-08-31 下线。
# TEXT_API_KEY=<your-kimi-api-key>
# TEXT_BASE_URL=https://api.moonshot.cn/v1
# TEXT_MODEL=kimi-k2.5

# 阿里云通义示例
# TEXT_API_KEY=<your-dashscope-api-key>
# TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TEXT_MODEL=qwen-turbo

# 没有 temperature / max_tokens 配置项：请求只发 model + messages，
# 其余全用 provider 默认值（思考模式保持开启，长度按各家上限）。
# 写死 max_tokens 会在长 README 上截断答案并落成"分析为空"。

# 可选：回退模型列表（逗号分隔）。留空表示只用一个模型。
TEXT_FALLBACK_MODELS=

# ============================================
# 视觉质检角色（多模态，独立配置）
# ============================================
# 上面的 TEXT_* 只处理纯文本，这里是看图角色。两者禁止互为 fallback：
# 文本模型收到图片会编造一个像样的"通过"结论，假通过比没有结论更糟。
#
# ⚠️ api.moonshot.cn 与 api.moonshot.ai 是两个独立平台：账号、密钥、计价货币
# 都不通用，双方文档互不提及。跨平台填 key 只会得到 authentication_error。
# 国内服务器一律用 .cn —— 北京 IP 实测 .cn 10/10 通（~0.1s），.ai 6/10（4 次超时）。
VISION_API_KEY=<your-moonshot-cn-api-key>
VISION_BASE_URL=https://api.moonshot.cn/v1
VISION_MODEL=kimi-k3

# ============================================
# 生图角色（火山方舟 Seedream，独立配置）
# ============================================
# 必须用 Lite 而非 Pro：5.0 Pro 不支持组图（sequential_image_generation）。
IMAGE_GEN_API_KEY=<your-volcengine-ark-api-key>
IMAGE_GEN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_GEN_MODEL=doubao-seedream-5-0-260128
IMAGE_GEN_TIMEOUT_SECONDS=120
# 按出图张数计费（¥0.22/张）
IMAGE_GEN_MAX_PER_RUN=5
# 水印默认关闭；provider 默认 true，会盖"AI生成"
IMAGE_GEN_WATERMARK=false

# ============================================
# 长图渲染与视觉质检
# ============================================
# 三个开关默认全关，容器内验证通过后再逐个打开
RENDER_ENABLED=false
IMAGE_GEN_ENABLED=false
VISUAL_QA_ENABLED=false

RENDER_OUTPUT_DIR=/app/data/renders
RENDER_DEVICE_SCALE_FACTOR=2
# Chromium 单张纹理上限 16384px，超过会静默截断
RENDER_SEGMENT_MAX_HEIGHT=15000
RENDER_TIMEOUT_SECONDS=120
RENDER_RETENTION_DAYS=14

QA_MAX_ATTEMPTS=3
QA_MAX_REQUEST_BYTES=62914560
# 低于这个边长文字缺陷不再可辨，会被报成假通过；超体积时分段送检而不是继续缩小
QA_MIN_INSPECT_DIMENSION=900
QA_TIMEOUT_SECONDS=300

# 附件总预算（字节）；超预算保留长图，按 attachment_budget.py 的顺序丢平台图
ATTACHMENT_BUDGET_BYTES=20971520

# ============================================
# 平台文案产出
# ============================================
PUBLISH_PLATFORMS=xiaohongshu,wechat,x,instagram,zhihu,reddit
PUBLISHERS_ENABLED=false

# ============================================
# GitHub API 配置（必填）
# ============================================
GITHUB_TOKEN=<your-github-token>
GITHUB_CANDIDATE_LIMIT=24
GITHUB_ACTIVE_PROJECT_DAYS=14
GITHUB_SEARCH_QUERIES=
GITHUB_TRENDING_ATTEMPT_TIMEOUT_SECONDS=120
GITHUB_TRENDING_MAX_ATTEMPTS=10
GITHUB_TRENDING_TOTAL_TIMEOUT_SECONDS=60
GITHUB_SOCIAL_WINDOW_DAYS=14
GITHUB_RECENT_COMMENT_LIMIT=100
GITHUB_MIN_RECENT_COMMENTS_A=5
GITHUB_ACTIVITY_SIGNAL_THRESHOLD=10

# arXiv 与动态研究内容选择
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.LG,cs.IR,cs.RO
ARXIV_CANDIDATE_LIMIT=24
ARXIV_TIMEOUT_SECONDS=20
TARGET_ITEMS=10
MAX_ITEMS=24

# ============================================
# Gmail SMTP 配置（必填）
# ============================================
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
DIGEST_RECIPIENT=your_email@gmail.com

# ============================================
# 定时任务配置
# ============================================
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
DIGEST_PREPARE_LEAD_MINUTES=30
TIMEZONE=Asia/Shanghai

# ============================================
# 应用配置
# ============================================
DEBUG=false
ADMIN_API_KEY=
LOG_LEVEL=INFO

# CORS 允许的来源（逗号分隔）
CORS_ALLOW_ORIGINS=https://senweiv.github.io,http://localhost:3000
